{
  "variables": {
    "aws_access_key": "{{env `bamboo_AWS_ACCESS_KEY_ID`}}",
    "aws_secret_key": "{{env `bamboo_AWS_SECRET_ACCESS_KEY`}}",
    "artifact_version": "{{env `ARTIFACT_VERSION`}}",
    "vpc_id": "{{env `VPC_ID`}}",
    "subnet_id": "{{env `SUBNET_ID`}}",
    "ec2_region": "{{env `EC2_REGION`}}",
    "ami_name": "icfar-cse-{{isotime \"02-Jan-2006-03-04-05\"}}"
  },
  "builders": [
    {
      "type": "amazon-ebs",
      "access_key": "{{user `aws_access_key`}}",
      "secret_key": "{{user `aws_secret_key`}}",
      "vpc_id": "{{user `vpc_id`}}",
      "region": "{{user `ec2_region`}}",
      "subnet_id": "{{user `subnet_id`}}",
      "source_ami_filter": {
        "filters": {
          "virtualization-type": "hvm",
          "name": "icfar-boilerplate-*",
          "root-device-type": "ebs",
          "tag:stable": "true"
        },
        "owners": ["self"],
        "most_recent": true
      },
      "instance_type": "m5.large",
      "ssh_username": "ec2-user",
      "ami_name": "{{user `ami_name`}}",
      "ami_description": "{{user `ami_name`}}",
      "ami_regions": ["us-east-1", "us-east-2", "us-west-2"],
      "tags": {
        "Name": "{{user `ami_name`}}",
        "date-created": "{{isotime \"02-Jan-2006\"}}",
        "packer-generated": "true",
        "stable": "true",
        "artifact_version": "{{user `artifact_version`}}",
        "built_from_ami_name": "{{.SourceAMIName}}",
        "opens": "true",
        "crowdstrike": "true",
        "splunk": "false",
        "vector": "true",
        "elasticsearch": "true",
        "notes": "Service AMI For Custom Split Evaluator"
      },
      "run_tags": {
        "Name": "{{user `ami_name`}}"
      },
      "run_volume_tags": {
        "Name": "{{user `ami_name`}}"
      },
      "snapshot_tags": {
        "Name": "{{user `ami_name`}}",
        "date-created": "{{isotime \"02-Jan-2006\"}}",
        "packer-generated": "true",
        "stable": "true",
        "artifact_version": "{{user `artifact_version`}}",
        "built_from_ami_name": "{{.SourceAMIName}}",
        "opens": "true",
        "crowdstrike": "true",
        "splunk": "false",
        "vector": "true",
        "elasticsearch": "true",
        "notes": "Service AMI For Custom Split Evaluator - Snapshot"
      },
      "metadata_options": {
        "http_endpoint": "enabled",
        "http_tokens": "required"
      }
    }
  ],
  "provisioners": [
    {
      "type": "ansible-local",
      "playbook_dir": "../../ansible/plays/",
      "playbook_file": "../../ansible/plays/customSplitEvaluator.yml",
      "role_paths": ["../../ansible/roles/java", "../../ansible/roles/jetty", "../../ansible/roles/customSplitEvaluator", "../../ansible/roles/eracent-installer"],
      "extra_arguments": ["--extra-vars \"artifact_version={{user `artifact_version`}}\""]
    }
  ],
  "post-processors": [
    {
      "type": "manifest",
      "output": "cse_result_{{isotime \"02-Jan-2006\"}}.json",
      "strip_path": true
    }
  ]
}
