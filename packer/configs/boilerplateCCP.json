{
  "variables": {
    "ccptoken": "{{env `CCPTOKEN`}}",
    "ccpacct": "{{env `CCPACCT`}}",
    "tenant": "{{env `TENANT`}}",
    "ccpregion": "{{env `REGION`}}",
    "rail": "{{env `RAIL`}}",
    "ccpaz": "az1",
    "cmi-name": "icfar-boilerplate-{{isotime \"02-Jan-2006-03-04-05\"}}"
  },

  "builders": [
    {
      "xcloud_account": "{{user `ccpacct`}}",
      "in_tenant": "{{user `tenant`}}",
      "region": "{{user `ccpregion`}}",
      "in_rail": "{{user `rail`}}",
      "az": "{{user `ccpaz`}}",
      "token": "{{user `ccptoken`}}",
      "name": "xcloud-{{user `ccpregion`}}",
      "template_name": "{{user `cmi-name`}}",
      "deployment_name": "{{user `cmi-name`}}",
      "reason": "Deploy VM {{user `cmi-name`}}",
      "description": "packer image {{user `cmi-name`}}",
      "vm_name": "{{user `cmi-name`}}",
      "type": "xcloud",
      "catalog": "Linux",
      "in_CMI": "Comcast-CentOS-7",
      "api": "https://api.xcloud.comcast.com/api",
      "id_timeout": 90,
      "shutdown_timeout": 120,
      "template_timeout": 20,
      "ip_timeout": 10,
      "delete_vm": true,
      "in_count": 1,
      "in_flavor": "CC.1cpu-1GB",
      "in_boot_capacity": 50,
      "in_ipv": "IPv4_IPv6",
      "in_tags": "ccp:6.0",
      "in_config": "CCPcloudconfig.yaml",
      "communicator": "ssh",
      "ssh_bastion_host": "jump-tsf.autobahn.comcast.com",
      "ssh_bastion_port": "22",
      "ssh_port": "22",
      "ssh_timeout": "3m",
      "ssh_username": "centos",
      "ssh_bastion_username": "svcAutobahn",
      "ssh_bastion_agent_auth": true,
      "ssh_agent_auth": true
    }
  ],

  "provisioners": [
    {
      "type": "shell",
      "execute_command": "chmod 755 {{ .Path }}; {{ .Vars }} {{ .Path }}",
      "inline": [
        "sudo cloud-init status --wait; sleep 30; sudo cloud-init clean -l",
        "sudo systemctl enable cloud-init-re-exec.service",
        "sudo /etc/cloud/clean.sh",

        "sudo yum install -y python-pip",
        "sudo pip install --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org pip==20.3.4",
        "sudo pip install --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org -U setuptools",
        "sudo pip install --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org ansible",
        "sudo pip install --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org --ignore-installed hvac==0.4.0",
        "sudo pip install --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org --ignore-installed lxml",

        "sudo chmod -R 755 /usr/lib/python2.7",
        "sudo chmod -R 755 /usr/lib64/python2.7"
      ]
    },
    {
      "type": "ansible-local",
      "playbook_dir": "../../ansible/plays/",
      "playbook_file": "../../ansible/plays/boilerplateCCP.yml",
      "role_paths": ["../../ansible/roles/boilerplateCCP", "../../ansible/roles/atlas-yumrepoCCP", "../../ansible/roles/vector"]
    }
  ]
}
