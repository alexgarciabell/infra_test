# TSP Admin - Hatsmaker Templated HAProxy Configuration File
#
# Notes:
# - This Hatsmaker template should be used for the following FAR UI services:
#   - TSP Admin (as of now, this is ADS Admin)
#
# - Traffic shaping in this regard is recursive considering that TSP is the medium. Therefore, it perhaps makes more
#    sense to take Hatsmaker out of the equation and use a different strategy for setting the hosts.

global
  daemon
  pidfile /var/run/haproxy.pid
  maxconn 120000
  nbproc {{ haproxy_nbproc }}
  {% for cpu in range(haproxy_nbproc) %}
  cpu-map {{ cpu + 1 }} {{ cpu }}
  {% endfor %}
  group haproxy
  user haproxy
  tune.ssl.default-dh-param 1024
  tune.http.logurilen 20480
  #tune.ssl.cachesize 10000000
  #tune.ssl.lifetime 600
  #tune.ssl.maxrecord 1460
  ssl-default-bind-ciphers ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256:ECDHE-ECDSA-AES128-SHA:ECDHE-RSA-AES256-SHA384:ECDHE-RSA-AES128-SHA:ECDHE-ECDSA-AES256-SHA384:ECDHE-ECDSA-AES256-SHA:ECDHE-RSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES128-SHA:DHE-RSA-AES256-SHA256:DHE-RSA-AES256-SHA:ECDHE-ECDSA-DES-CBC3-SHA:ECDHE-RSA-DES-CBC3-SHA:EDH-RSA-DES-CBC3-SHA:AES128-GCM-SHA256:AES256-GCM-SHA384:AES128-SHA256:AES256-SHA256:AES128-SHA:AES256-SHA:DES-CBC3-SHA:!DSS
  ssl-default-bind-options no-sslv3 no-tls-tickets
  ssl-default-server-ciphers ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256:ECDHE-ECDSA-AES128-SHA:ECDHE-RSA-AES256-SHA384:ECDHE-RSA-AES128-SHA:ECDHE-ECDSA-AES256-SHA384:ECDHE-ECDSA-AES256-SHA:ECDHE-RSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES128-SHA:DHE-RSA-AES256-SHA256:DHE-RSA-AES256-SHA:ECDHE-ECDSA-DES-CBC3-SHA:ECDHE-RSA-DES-CBC3-SHA:EDH-RSA-DES-CBC3-SHA:AES128-GCM-SHA256:AES256-GCM-SHA384:AES128-SHA256:AES256-SHA256:AES128-SHA:AES256-SHA:DES-CBC3-SHA:!DSS
  log 127.0.0.1:4560 len 20480 local1 info
  log-send-hostname
  stats socket /var/run/haproxy.sock mode 666 level user

defaults
  mode http
  option httplog
  option log-health-checks
  option log-separate-errors
  option http-keep-alive
  option clitcpka
  timeout connect 5s
  timeout client 5s
  timeout server 5s
  balance roundrobin
  default-server inter 5s fall 3 rise 1
  monitor-uri /haproxy_test
  monitor-net 192.168.3.2/31
  monitor-net 96.114.160.2/31
  log-format '{ "hap.frontend":"%f" , "hap.backhost":"%s" , "hap.frontname":"%ft" , "hap.backname":"%b" , "hap.back_status":%ST , "hap.client_ip":"%ci" , "hap.tq":%Tq , "hap.tw":%Tw , "hap.tc":%Tc , "hap.tr":%Tr , "hap.tt":%Tt , "hap.term_state":"%tsc" , "hap.act_conn":%ac , "hap.front_conn":%fc , "hap.back_conn":%bc , "hap.srv_conn":%sc , "hap.retries":%rc , "hap.srv_queue":%sq , "hap.back_queue":%bq , "hap.req_timestamp":"%tr" , "hap.req_call":"%r" }'

listen stats
  bind 0.0.0.0:10543
  mode http
  log global
  stats uri /haproxy-stats

# Frontend Configurations
# These configurations note what ports HAProxy should be listening on and how the connections are to be treated. There
# will be one set of configurations per service, if multiple services are set up.

frontend appdiscoveryAdminService
# Listen on IPv4 (Service Port) - Should not be listened on
  #bind *:10432 name appdiscoveryAdminService
# Listen on IPv4 (SSL Port) (The port in PROD is 443 but in CI it's 9443. Be sure to manually change it for CI.)
  bind *:443 ssl crt /etc/haproxy/appdiscoveryAdminService.pem
  log global
  maxconn 10000
  option httplog
  log-format '{ "hap.frontend":"%f" , "hap.backhost":"%s" , "hap.frontname":"%ft" , "hap.backname":"%b" , "hap.back_status":%ST , "hap.client_ip":"%ci" , "hap.tq":%Tq , "hap.tw":%Tw , "hap.tc":%Tc , "hap.tr":%Tr , "hap.tt":%Tt , "hap.term_state":"%tsc" , "hap.act_conn":%ac , "hap.front_conn":%fc , "hap.back_conn":%bc , "hap.srv_conn":%sc , "hap.retries":%rc , "hap.srv_queue":%sq , "hap.back_queue":%bq , "hap.req_timestamp":"%tr" , "hap.req_call":"%r" }'
  option forwardfor if-none
# Set header HA-Forwarded-For which broadcasts the client IP
  http-request set-header HA-Forwarded-For %ci
# Listen for certain headers which are used for TSP based traffic shaping configs
  capture request header X-Forwarded-For len 64
  capture request header X-ServiceAccountId len 64
  capture request header X-ServiceDeviceId len 64
# Get the User-Agent of the calling client
  capture request header User-Agent len 64
# Check if the request was received over HTTPS and store result (for Backend SSL)
  #acl https ssl_fc

# Backend Configurations - Rules
# These are evaluated in the order that they appear. The first one to match is used.
# The UIs are automatically assumed to be Backend SSL (Jetty or True) compliant due to the current treatment of UIs
# This is reflected in the backend configs themselves
# Substitute configure_me with the ADS Admin version

  default_backend appdiscoveryAdminService.configure_me

# Backend Configurations - Host Lists

# Backend SSL is configured - Substitute fill_in_hostname_of_adsadmin and 0.0.0.0 for the hostname and IP address of the ADS Admin host

backend appdiscoveryAdminService.configure_me
    server fill_in_hostname_of_adsadmin 0.0.0.0:9443 ssl verify none maxconn 200 check
