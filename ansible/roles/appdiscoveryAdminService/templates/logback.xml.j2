<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <jmxConfigurator/>
    <appender name="elk_async" class="net.logstash.logback.appender.LoggingEventAsyncDisruptorAppender">
        <appender class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>127.0.0.1:4560</destination>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service.environment":"${envType}"}</customFields>
                <fieldNames>
                    <version>[ignore]</version>
                    <logger>log.logger</logger>
                    <level>log.level</level>
                    <thread>process.thread.name</thread>
                    <levelValue>event.severity</levelValue>
                    <stackTrace>error.stack_trace</stackTrace>
                </fieldNames>
            </encoder>
        </appender>
    </appender>

    <logger name="com.comcast.xre.metrics" level="WARN"/>
    <logger name="com.comcast" level="INFO"/>
    <logger name="org.eclipse" level="WARN"/>
    <logger name="org.spring" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="httpclient" level="WARN"/>
    <root>
        <level value="INFO"/>
        <appender-ref ref="elk_async"/>
    </root>
</configuration>