#cloud-config
cloud_final_modules:
  - [scripts-user, always]
runcmd:
  - |
    TRIGGER_FILE="/tmp/packer-provisioner-ansible-local/trigger-file"
    if [ -f TRIGGER_FILE ]; then
        echo "Running user-data ..."
        cd /tmp/packer-provisioner-ansible-local
        cd "$(\ls -1dt ./*/ | head -n 1)"
        # Setting up Autobahn
        #echo coast.coast-services.coast > /etc/ssh/authorized_principals/centos
        # Impossible to create extra-vars file that contain colon ":" delimiter between key and value, so passing extra vars inline
        ansible-playbook -vvvv --connection=local --inventory 127.0.0.1, hatsmakerv2-forced.yml --extra-vars "ads_endpoint_codebig=${ads_tsp_cb_url} ads_endpoint_local=${ads_tsp_normal_url} service_name=${service_name} cert_name=${cert_name} haproxy_template=${haproxy_template} service_ssl_port=${service_ssl_port} service_ssl_ipv6_enabled=${service_ssl_ipv6_enabled} service_ssl_backend_enabled=${service_ssl_backend_enabled} hats_id=${hats_id} env_type=${env_type} env_certs=${env_certs} elk_domain=${elk_domain} VECTOR_LOG_INDEX=${vector_log_index} HAPROXY_LOG_INDEX=${haproxy_log_index} swidtag_file=${swidtag_file} run_number=b" > local_2nd_ansible_run.txt
        # Extend boot disk to have access to full capacity
        growpart /dev/sda 2
        pvresize /dev/sda2
        lvextend -rl +95%FREE /dev/$(vgs --noheadings | awk '{print $1}')/root
        rm TRIGGER_FILE
    else
        echo "Skipping user-data execution"
        sudo touch "TRIGGER_FILE"
        echo "trigger file created"
    fi